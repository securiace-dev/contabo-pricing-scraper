# Copy to a local .env file for Dokploy or host-side docker compose usage.
# The live WHMCS addon must point at http://contabo-pricing:8080/api/v1 from
# inside the WHMCS container; the host paths below stay operator-owned.
# Pin the exact image you are deploying. Use the release's immutable digest ref,
# not :latest or another mutable tag.

WHMCS_DOCKER_NETWORK=whmcs-production-jvjwfo_default
CONTABO_PRICING_IMAGE=ghcr.io/securiace-dev/contabo-pricing-scraper@sha256:replace_with_release_digest
CONTABO_DATA_HOST_DIR=/var/lib/contabo-pricing/output
CONTABO_AUTH_TOKEN_HOST_FILE=/etc/contabo-pricing/auth_token
CONTABO_PRICING_API_BASE_URL=http://contabo-pricing:8080/api/v1

# Optional non-secret overrides:
# CONTABO_CORS_ORIGIN=
# RUST_LOG=info
# FETCH_MODE=reqwest
