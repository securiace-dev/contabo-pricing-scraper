node_modules/
.DS_Store

# Scraped output — regenerated by running the scraper
data/output/

# Rust build artifacts
target/

# Local scratch files
tmp/
*.log

# PHP addon: composer deps + phpunit cache are dev-only. The addon ships with a
# stub autoloader, so prod runs without vendor/ (it's excluded from deploys too).
vendor/
.phpunit.cache/
composer.phar

# Proxy credential — never commit
deploy/proxy.env

# Tool state directories
.claude-flow/
.kilo/
.swarm/
ruvector.db
ruvector.db-*
.claude/memory.db
.claude/memory.db-*
.claude/schema.sql
.claude/state.json
.claude/worktrees/
# repowise codebase-doc engine: regenerable wiki cache + local session state
.repowise/

# MemPalace per-project files — SHARED with team (now tracked: mempalace.yaml,
# entities.json). The palace database itself stays local to each machine.

# graphify knowledge graph — SHARED artifacts are committed (graph.json,
# graph.html, GRAPH_REPORT.md, manifest.json, memory/). Ignore only the
# machine-local interpreter pin, the bulky regenerable cache, and token tally.
graphify-out/.graphify_python
graphify-out/cache/
graphify-out/cost.json

# graphify machine-local markers
graphify-out/.graphify_root
